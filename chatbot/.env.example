# ── AI Model (Ollama Cloud) ───────────────────────────────────────────
# API endpoint for the AI model
MODEL_API_URL=https://api.ollama.com/api/generate
# Your Ollama Cloud API Key (get one at https://ollama.com)
MODEL_API_KEY=your_ollama_api_key_here
# Model to use (must be available on your Ollama account)
MODEL_NAME=gemma3:27b-cloud
# Set to 0 to disable timeout (recommended for large models that are slow)
MODEL_TIMEOUT_MS=0

# ── Emergency Messages ────────────────────────────────────────────────
EMERGENCY_DISPATCH_MESSAGE=Notre système transmet la demande en priorité au service d'urgence partenaire pour accélérer l'envoi d'une ambulance.

# ── Camunda (Workflow Engine - Optional) ─────────────────────────────
# Leave these empty if you don't use Camunda
CAMUNDA_CREATE_INSTANCE_URL=
CAMUNDA_BPMN_PROCESS_ID=
CAMUNDA_PROCESS_VERSION=-1
CAMUNDA_BEARER_TOKEN=
CAMUNDA_OAUTH_TOKEN_URL=
CAMUNDA_OAUTH_CLIENT_ID=
CAMUNDA_OAUTH_CLIENT_SECRET=
CAMUNDA_OAUTH_AUDIENCE=
CAMUNDA_TENANT_ID=
